rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Test connection document
    match /test/connection {
      allow read, write: if true;
    }

    // System Settings (Gemini shared API key) - readable by any authenticated user, writable by admin
    match /system_settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Companies directory (readable by authenticated users)
    match /companies/{companyId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // User profiles (users can read/write own profile, or admin)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
    }

    // Expense claims & payment vouchers with role-based access
    match /claims/{claimId} {
      allow read, write: if request.auth != null;
    }
  }
}
