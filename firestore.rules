rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Test connection document
    match /test/connection {
      allow read, write: if true;
    }

    // System Settings (Gemini shared API key, admin_bootstrap, security_policy)
    match /system_settings/{settingId} {
      allow read, write: if request.auth != null;
      
      // Strict rule for admin_bootstrap initial creation
      allow create: if settingId == 'admin_bootstrap' && request.auth != null && !exists(/databases/$(database)/documents/system_settings/admin_bootstrap);
    }

    // Companies directory
    match /companies/{companyId} {
      allow read, write: if request.auth != null;
    }

    // User profiles
    match /users/{userId} {
      allow read, write, delete: if request.auth != null;
    }

    // Expense claims & payment vouchers
    match /claims/{claimId} {
      allow read, write, delete: if request.auth != null;
    }
  }
}
