{
  "entities": {
    "Company": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 150 },
        "regNo": { "type": "string", "maxLength": 50 },
        "subtitle": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 250 },
        "headerAlign": { "type": "string", "maxLength": 20 },
        "voucherPrefix": { "type": "string", "maxLength": 20 }
      },
      "required": ["id", "name", "regNo"]
    },
    "UserProfile": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 20 },
        "defaultCompanyId": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "email", "role"]
    },
    "ExpenseItem": {
      "type": "object",
      "properties": {
        "lineNo": { "type": "number" },
        "date": { "type": "string", "maxLength": 20 },
        "merchant": { "type": "string", "maxLength": 150 },
        "receiptNo": { "type": "string", "maxLength": 50 },
        "particulars": { "type": "string", "maxLength": 300 },
        "accountCode": { "type": "string", "maxLength": 20 },
        "accountName": { "type": "string", "maxLength": 100 },
        "taxCode": { "type": "string", "maxLength": 10 },
        "taxAmountRM": { "type": "number" },
        "netAmountRM": { "type": "number" },
        "amountRM": { "type": "number" },
        "receiptImageUrl": { "type": "string", "maxLength": 5000 }
      },
      "required": ["lineNo", "merchant", "amountRM", "accountCode"]
    },
    "ClaimVoucher": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50 },
        "voucherNo": { "type": "string", "maxLength": 50 },
        "companyId": { "type": "string", "maxLength": 50 },
        "claimantId": { "type": "string", "maxLength": 50 },
        "payTo": { "type": "string", "maxLength": 100 },
        "voucherDate": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "maxLength": 20 },
        "paymentMethod": { "type": "string", "maxLength": 20 },
        "bankAccountCode": { "type": "string", "maxLength": 20 },
        "chequeNo": { "type": "string", "maxLength": 50 },
        "totalAmountRM": { "type": "number" },
        "approvedBy": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 20 }
      },
      "required": ["id", "voucherNo", "companyId", "claimantId", "totalAmountRM", "status"]
    }
  },
  "firestore": {
    "paths": {
      "companies/{companyId}": {
        "schema": "Company",
        "read": "true",
        "write": "request.auth != null"
      },
      "users/{userId}": {
        "schema": "UserProfile",
        "read": "true",
        "write": "request.auth != null"
      },
      "claims/{claimId}": {
        "schema": "ClaimVoucher",
        "read": "true",
        "write": "request.auth != null"
      },
      "test/connection": {
        "read": "true",
        "write": "request.auth != null"
      }
    }
  }
}
